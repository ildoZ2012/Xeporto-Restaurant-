  <title>Xepοrto | Mediterranean Mezze Restaurant</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Georgia, "Times New Roman", serif;
      background: #f7f1e7;
      color: #25352f;
      line-height: 1.6;
    }

    header {
      background:
        linear-gradient(rgba(28, 54, 46, .78), rgba(28, 54, 46, .78)),
        linear-gradient(135deg, #31594c, #172d27);
      color: white;
      text-align: center;
      padding: 70px 20px 60px;
    }

    .logo {
      font-size: 58px;
      letter-spacing: 4px;
      font-weight: bold;
      margin-bottom: 5px;
    }

    .subtitle {
      font-size: 18px;
      font-style: italic;
      color: #e8d7b7;
      margin-bottom: 25px;
    }

    .chef {
      font-size: 14px;
      opacity: .9;
      margin-bottom: 25px;
    }

    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: #fffaf2;
      border-bottom: 1px solid #ded2bf;
      box-shadow: 0 2px 12px rgba(0,0,0,.08);
    }

    nav ul {
      list-style: none;
      display: flex;
      justify-content: center;
      gap: 35px;
      padding: 15px;
    }

    nav a {
      color: #25352f;
      text-decoration: none;
      font-weight: bold;
      font-size: 15px;
    }

    nav a:hover {
      color: #9a7040;
    }

    .hours {
      background: #eadbc1;
      text-align: center;
      padding: 14px 20px;
      font-size: 15px;
    }

    .hours strong {
      color: #25352f;
    }

    .kitchen {
      color: #8a4d36;
      font-weight: bold;
    }

    section {
      max-width: 1050px;
      margin: auto;
      padding: 65px 20px;
    }

    .intro {
      text-align: center;
      padding-bottom: 35px;
    }

    .intro h2 {
      font-size: 34px;
      color: #31594c;
      margin-bottom: 15px;
    }

    .intro p {
      max-width: 700px;
      margin: auto;
      color: #5e665f;
    }

    .section-title {
      font-size: 31px;
      color: #31594c;
      border-bottom: 2px solid #c7b28f;
      padding-bottom: 10px;
      margin-bottom: 30px;
    }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 45px;
    }

    .menu-item {
      padding: 15px 0;
      border-bottom: 1px solid #dfd4c4;
    }

    .item-top {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      font-weight: bold;
      font-size: 17px;
    }

    .price {
      white-space: nowrap;
      color: #8a6135;
    }

    .description {
      color: #687069;
      font-size: 14px;
      margin-top: 4px;
    }

    .allergens {
      color: #8a4d36;
      font-size: 12px;
      font-style: italic;
      margin-top: 3px;
    }

    .tag {
      color: #31594c;
      font-size: 12px;
      font-weight: bold;
    }

    .drinks {
      background: #eee4d4;
      max-width: none;
    }

    .drink-inner {
      max-width: 1050px;
      margin: auto;
      padding: 0 20px;
    }

    .drink-columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
    }

    .drink-group {
      margin-bottom: 30px;
    }

    .drink-group h3 {
      color: #31594c;
      font-size: 22px;
      margin-bottom: 10px;
    }

    .drink-row {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px dotted #c9bba5;
      padding: 5px 0;
      gap: 15px;
    }

    .contact {
      text-align: center;
      background: #31594c;
      color: white;
      max-width: none;
      padding: 60px 20px;
    }

    .contact h2 {
      font-size: 32px;
      margin-bottom: 15px;
    }

    .contact p {
      margin: 7px 0;
      color: #e9dfcf;
    }

    .call-button {
      display: inline-block;
      margin-top: 20px;
      padding: 13px 28px;
      background: #d5b37a;
      color: #24352e;
      text-decoration: none;
      border-radius: 4px;
      font-weight: bold;
    }

    footer {
      background: #192d27;
      color: #bfc8c1;
      text-align: center;
      padding: 22px;
      font-size: 13px;
    }

    @media (max-width: 750px) {
      .logo {
        font-size: 43px;
      }

      nav ul {
        gap: 18px;
        flex-wrap: wrap;
      }

      .menu-grid,
      .drink-columns {
        grid-template-columns: 1fr;
      }

      .section-title {
        font-size: 27px;
      }

      section {
        padding: 45px 18px;
      }
    }
  </style>
</head>

